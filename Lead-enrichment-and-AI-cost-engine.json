        "jsCode": "const rawData = $json.callback_query?.data || $json.data || '';\n\nconst firstUnderscoreIndex = rawData.indexOf('_');\n\nlet action = 'approve';\nlet identifier = '';\n\nif (firstUnderscoreIndex !== -1) {\n  action = rawData.substring(0, firstUnderscoreIndex);\n  identifier = rawData.substring(firstUnderscoreIndex + 1).trim();\n} else {\n  action = rawData;\n}\n\nreturn {\n  json: {\n    raw_data: rawData,\n    action: action,\n    target: identifier\n  }\n};"

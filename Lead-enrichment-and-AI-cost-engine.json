    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Получаем ответ от родной ноды Gemini (текст лежит либо в content, либо в response.text, либо в text)\nconst aiRaw = $json.text || $json.response?.text || $json.content?.parts?.[0]?.text || '';\n\n// Очищаем от возможных markdown-оберток (```json ... ```)\nconst cleanJsonText = aiRaw.replace(/```(?:json)?/gi, '').replace(/```/g, '').trim();\n\nlet parsedAI = {};\ntry {\n  parsedAI = JSON.parse(cleanJsonText);\n} catch (e) {\n  parsedAI = {\n    qualification_status: \"qualified\",\n    value_prop: cleanJsonText || \"N/A\",\n    personalized_icebreaker: \"Great work scaling your team!\",\n    pain_point: \"Outbound workflow automation\"\n  };\n}\n\n// Забираем исходные данные лида из ноды очистки контекста:\nconst leadData = $('DB records').first().json;\n\nreturn {\n  email: leadData.email,\n  company_name: leadData.company_name,\n  domain: leadData.domain,\n  qualification: parsedAI.qualification_status || \"qualified\",\n  value_prop: parsedAI.value_prop || \"N/A\",\n  icebreaker: parsedAI.personalized_icebreaker || \"N/A\",\n  pain_point: parsedAI.pain_point || \"N/A\",\n  processed_at: new Date().toISOString()\n};"

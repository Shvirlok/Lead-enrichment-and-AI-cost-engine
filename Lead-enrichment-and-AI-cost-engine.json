    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let score = 50; // Базовый балл\n  const title = (item.json.title || '').toLowerCase();\n\n  // Добавляем топ-должности: VP, C-level, Head, Director, Founder\n  if (\n    title.includes('ceo') || \n    title.includes('founder') || \n    title.includes('owner') || \n    title.includes('head') ||\n    title.includes('vp') || \n    title.includes('president') || \n    title.includes('chief')\n  ) {\n    score += 35; // Сразу будет 85 баллов\n  } else if (\n    title.includes('director') || \n    title.includes('manager') || \n    title.includes('lead')\n  ) {\n    score += 20; // Будет 70 баллов\n  }\n\n  item.json.lead_score = score;\n}\n\nreturn $input.all();"
      },
